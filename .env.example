# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform API key for @vis.gl/react-google-maps.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Cloud SQL PostgreSQL connection variables (injected at runtime; never use DATABASE_URL).
SQL_HOST="127.0.0.1"
SQL_USER="appuser"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_DB_NAME="resqnet"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"
