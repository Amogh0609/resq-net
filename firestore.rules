rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'amogh692006@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'agency', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() <= 16 && data.role in ['citizen', 'officer', 'admin'] &&
        (!data.keys().hasAny(['agency']) || (data.agency is string && data.agency.size() <= 40)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdmin(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.grantedAt is timestamp;
    }

    function isValidRun(data, userId, runId) {
      return data.keys().hasAll([
          'runId', 'ownerId', 'profile', 'baseCapacityMW', 'fairnessWeight',
          'negotiatedDamage', 'uncoordinatedDamage', 'jainsFairness', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'runId', 'ownerId', 'profile', 'baseCapacityMW', 'fairnessWeight',
          'negotiatedDamage', 'uncoordinatedDamage', 'jainsFairness', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.runId is string && data.runId == runId && data.runId.size() >= 1 && data.runId.size() <= 64 &&
        data.runId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId is string && data.ownerId == userId && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.profile is string && data.profile.size() >= 1 && data.profile.size() <= 48 &&
        data.baseCapacityMW is number && data.baseCapacityMW >= 10 && data.baseCapacityMW <= 5000 &&
        data.fairnessWeight is number && data.fairnessWeight >= 0 && data.fairnessWeight <= 1 &&
        data.negotiatedDamage is number && data.negotiatedDamage >= 0 &&
        data.uncoordinatedDamage is number && data.uncoordinatedDamage >= 0 &&
        data.jainsFairness is number && data.jainsFairness >= 0 && data.jainsFairness <= 1 &&
        data.status is string && data.status.size() <= 16 && data.status in ['active', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEscalation(data, escalationId) {
      return data.keys().hasAll([
          'escalationId', 'authorId', 'category', 'areaName', 'severity',
          'summary', 'lat', 'lon', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'escalationId', 'authorId', 'category', 'areaName', 'severity',
          'summary', 'lat', 'lon', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.escalationId is string && data.escalationId == escalationId && data.escalationId.size() >= 1 && data.escalationId.size() <= 64 &&
        data.escalationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
        data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 48 &&
        data.areaName is string && data.areaName.size() >= 1 && data.areaName.size() <= 64 &&
        data.severity is string && data.severity.size() <= 16 && data.severity in ['low', 'medium', 'high', 'critical'] &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lon is number && data.lon >= -180 && data.lon <= 180 &&
        data.status is string && data.status.size() <= 16 && data.status in ['open', 'dispatched', 'resolved'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users_public/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role in ['citizen', 'officer'] || isAdmin());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'agency', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /runs/{runId} {
        allow get: if isValidId(userId) && isValidId(runId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
        allow create: if isValidId(userId) && isValidId(runId) && isOwner(userId) &&
          isValidRun(incoming(), userId, runId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users_public/$(userId)) &&
          get(/databases/$(database)/documents/users_public/$(userId)).data.uid == request.auth.uid;
        allow update: if isValidId(userId) && isValidId(runId) && (isOwner(userId) || isAdmin()) &&
          isValidRun(incoming(), userId, runId) &&
          incoming().runId == existing().runId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isAdmin() ||
            (
              existing().status != 'archived' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(runId) && (isOwner(userId) || isAdmin());
      }
    }

    match /users_private/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() &&
        isValidAdmin(incoming(), userId) &&
        incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /escalations/{escalationId} {
      allow get: if isValidId(escalationId) && isSignedIn() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isValidId(escalationId) && isSignedIn() &&
        isValidEscalation(incoming(), escalationId) &&
        incoming().authorId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users_public/$(request.auth.uid));
      allow update: if isValidId(escalationId) && isSignedIn() &&
        isValidEscalation(incoming(), escalationId) &&
        incoming().escalationId == existing().escalationId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['summary', 'severity', 'updatedAt'])
          )
        );
      allow delete: if isValidId(escalationId) && (isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));
    }
  }
}
